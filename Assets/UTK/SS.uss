#container {
    flex-grow: 1;
    background-color: rgb(25, 25, 30);
    padding: 40px;
    align-items: center;
}

#difficulty-area {
    flex-direction: row; /* 横並び */
    align-items: center;
    margin-bottom: 30px;
}

#difficulty-label {
    font-size: 32px;
    color: white;
    margin-right: 20px;
}

#difficulty-button {
    font-size: 20px;
    padding: 10px 20px;
    background-color: rgb(200, 50, 50);
    color: white;
    border-radius: 5px;
}

#song-list {
    width: 80%;
    max-height: 70%;
    background-color: rgb(40, 40, 45);
    border-radius: 10px;
    padding: 10px;
}

/* スクリプトから動的に追加する曲ボタンのスタイル */
.song-button {
    font-size: 24px;
    padding: 20px;
    margin: 5px 0;
    background-color: rgb(60, 60, 70);
    color: white;
    border-radius: 8px;
    border-width: 0;
    text-align: left;
}

.song-button:hover {
    background-color: rgb(80, 80, 95);
}